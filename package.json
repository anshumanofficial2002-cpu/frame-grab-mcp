{
  "name": "frame-grab-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets your AI see your videos: grab frames as images, sample a whole clip, build contact sheets, detect scene cuts, pick the sharpest frame and export platform-sized thumbnails.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "frame-grab-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ffmpeg",
    "video",
    "thumbnails",
    "scene-detection",
    "contact-sheet",
    "frames",
    "creator-tools",
    "claude"
  ],
  "author": "Anshuman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshumanofficial2002-cpu/frame-grab-mcp.git"
  },
  "homepage": "https://github.com/anshumanofficial2002-cpu/frame-grab-mcp#readme",
  "bugs": {
    "url": "https://github.com/anshumanofficial2002-cpu/frame-grab-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
